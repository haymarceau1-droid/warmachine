# Mode de stockage de l'admin du blog (/keystatic)
#   local  : en développement, écrit dans le dossier du projet (par défaut)
#   github : en ligne, chaque publication crée un commit sur le dépôt
#   cloud  : en ligne via Keystatic Cloud (connexion par email, sans compte GitHub)
PUBLIC_KEYSTATIC_STORAGE=local

# Mode « github » — renseignés automatiquement à la première connexion sur /keystatic
# (création de la GitHub App), puis à recopier dans les variables d’environnement Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Mode « cloud » — identifiant du projet créé sur keystatic.cloud (ex. equipe/projet)
PUBLIC_KEYSTATIC_CLOUD_PROJECT=
