---
import SectionHead from './SectionHead.astro';
import { AVIS } from '../data/site';
---
<section class="section section--light" id="avis">
  <div class="container">
    <SectionHead eyebrow="Ils en parlent" title="Nos membres sont satisfaits.<br/>Et nous aussi." />
    <div class="grid grid-3">
      {AVIS.map((a) => (
        <article class="avis">
          <div class="avis__top">
            <p class="avis__src">
              <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
              <span>Avis Google</span>
            </p>
            <h3 class="display avis__title">{`« ${a.titre} »`}</h3>
            <p class="avis__text">{a.texte}</p>
          </div>
          <div class="avis__author">
            <span class="avis__avatar display">{a.auteur[0]}</span>
            <span><strong>{a.auteur}</strong><br /><span class="small muted">Membre WM</span></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .avis { display: flex; flex-direction: column; justify-content: space-between; gap: 28px; padding: 32px; background: var(--light); }
  .avis__top { display: flex; flex-direction: column; gap: 18px; }
  .avis__src { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .avis__title { font-size: 34px; line-height: 1.05; }
  .avis__text { white-space: pre-line; font-size: 16px; line-height: 1.6; }
  .avis__author { display: flex; align-items: center; gap: 12px; font-size: 15px; }
  .avis__avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--navy); color: var(--white); display: grid; place-items: center; font-size: 20px; }
</style>
