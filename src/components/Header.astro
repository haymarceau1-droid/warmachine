---
import Icon from './Icon.astro';
import { NAV, ROUTES } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav-wrap">
  <nav class="nav" aria-label="Navigation principale">
    <a href="/" class="nav__logo" aria-label="WM Athletics — accueil">
      <img src="/logo-negatif.svg" alt="WM Athletics" width="152" height="22" />
    </a>
    <ul class="nav__pill">
      {NAV.map((l) => (
        <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <a href={ROUTES.essai} class="btn btn--primary nav__cta"><Icon name="calendrier" /><span>Essai gratuit</span></a>
    <button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Ouvrir le menu">
      <Icon name="menu" size={22} />
    </button>
  </nav>
  <div class="menu-mobile" id="menu-mobile" hidden>
    <ul>
      {NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={ROUTES.faq}>FAQ</a></li>
    </ul>
    <a href={ROUTES.essai} class="btn btn--primary btn--block"><Icon name="calendrier" /><span>Séance d’essai offerte</span></a>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav__burger');
  const menu = document.getElementById('menu-mobile');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
    if (menu) menu.hidden = open;
    document.body.classList.toggle('menu-open', !open);
  });
</script>

<style>
  .nav-wrap { position: fixed; inset: 20px 24px auto; z-index: 50; }
  .nav {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 10px 10px 10px 28px; border-radius: 999px;
    background: rgba(13, 26, 45, .55); border: 1px solid rgba(255, 255, 255, .14);
    -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, .25);
  }
  .nav__logo img { height: 22px; width: auto; }
  .nav__pill {
    display: flex; gap: 4px; padding: 4px; border-radius: 999px;
    background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12);
  }
  .nav__pill a {
    display: block; padding: 9px 16px; border-radius: 999px;
    font-family: var(--font-display); font-weight: 800; font-size: 16px; letter-spacing: .04em; text-transform: uppercase;
    transition: background-color .2s;
  }
  .nav__pill a:hover, .nav__pill a[aria-current='page'] { background: rgba(255, 255, 255, .1); }
  .nav__cta { padding: 13px 22px; }
  .nav__burger { display: none; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); border-radius: 999px; width: 46px; height: 46px; align-items: center; justify-content: center; cursor: pointer; }
  .menu-mobile {
    margin-top: 10px; padding: 24px; border-radius: 28px;
    background: rgba(13, 26, 45, .92); border: 1px solid rgba(255, 255, 255, .14);
    -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px);
  }
  .menu-mobile ul { display: grid; gap: 4px; margin-bottom: 20px; }
  .menu-mobile a:not(.btn) { display: block; padding: 10px 4px; font-family: var(--font-display); font-weight: 900; font-size: 34px; text-transform: uppercase; line-height: 1; }
  @media (max-width: 1100px) {
    .nav__pill a { padding: 9px 11px; font-size: 15px; }
  }
  @media (max-width: 960px) {
    .nav-wrap { inset: 12px 12px auto; }
    .nav { padding: 8px 8px 8px 20px; }
    .nav__pill, .nav__cta { display: none; }
    .nav__burger { display: inline-flex; }
  }
  @media (min-width: 961px) { .menu-mobile { display: none; } }
</style>
