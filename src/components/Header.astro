---
import Icon from './Icon.astro';
import { NAV, ROUTES, HORAIRES } from '../data/site';
const path = Astro.url.pathname;
const horaires = JSON.stringify(HORAIRES);
---
<header class="nav-wrap">
  <nav class="nav" aria-label="Navigation principale">
    <a href="/" class="nav__logo" aria-label="WM Athletics — accueil">
      <img src="/logo-negatif.svg" alt="WM Athletics" width="152" height="22" />
    </a>
    <ul class="nav__pill">
      {NAV.map((l) => (
        <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <div class="nav__right">
      <p class="statut statut--nav" data-statut data-horaires={horaires} hidden aria-live="polite">
        <span class="statut__dot" aria-hidden="true"></span><span class="statut__txt"></span>
      </p>
      <a href={ROUTES.essai} class="btn btn--primary nav__cta"><Icon name="calendrier" /><span>Essai gratuit</span></a>
    </div>
    <button class="nav__burger" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Ouvrir le menu">
      <span class="burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </nav>
  <div class="menu-mobile" id="menu-mobile" hidden>
    <p class="statut statut--menu" data-statut data-horaires={horaires} hidden>
      <span class="statut__dot" aria-hidden="true"></span><span class="statut__txt"></span>
    </p>
    <ul>
      {NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href={ROUTES.faq}>FAQ</a></li>
    </ul>
    <a href={ROUTES.essai} class="btn btn--primary btn--block"><Icon name="calendrier" /><span>Séance d’essai offerte</span></a>
  </div>
</header>

<script>
  // Statut « ouvert / fermé » calculé à partir de HORAIRES (heure de Paris, indépendante du fuseau du visiteur)
  const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
  const WD: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
  const fmt = (m: number) => { const h = Math.floor(m / 60), mn = m % 60; return mn ? `${h}h${String(mn).padStart(2, '0')}` : `${h}h`; };
  const toMin = (s: string) => { const [h, m] = s.split(':').map(Number); return h * 60 + m; };

  function updateStatut() {
    const nodes = document.querySelectorAll<HTMLElement>('[data-statut]');
    if (!nodes.length) return;
    const raw = JSON.parse(nodes[0].dataset.horaires || '[]') as [string, string][];
    // Index 0 = lundi dans HORAIRES → on convertit en 0 = dimanche
    const plages: Record<number, [number, number]> = {};
    raw.forEach(([, h], i) => {
      const [a, b] = h.split('–').map((x) => toMin(x.trim()));
      plages[(i + 1) % 7] = [a, b];
    });
    const p = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
    const get = (t: string) => p.find((x) => x.type === t)?.value ?? '0';
    const day = WD[get('weekday')];
    const now = Number(get('hour')) * 60 + Number(get('minute'));
    const today = plages[day];
    let open = false, text = '';
    if (today && now >= today[0] && now < today[1]) {
      open = true;
      text = now >= today[1] - 60 ? `Ouvert · ferme à ${fmt(today[1])}` : `Ouvert · jusqu’à ${fmt(today[1])}`;
    } else {
      for (let i = 0; i < 8; i++) {
        const d = (day + i) % 7, pl = plages[d];
        if (!pl || (i === 0 && now >= pl[0])) continue;
        const quand = i === 0 ? '' : i === 1 ? ' demain' : ` ${JOURS[d]}`;
        text = `Fermé · ouvre${quand} à ${fmt(pl[0])}`;
        break;
      }
    }
    nodes.forEach((n) => {
      n.classList.toggle('is-open', open);
      const t = n.querySelector('.statut__txt');
      if (t) t.textContent = text;
      n.hidden = !text;
    });
  }
  updateStatut();
  setInterval(updateStatut, 60_000);

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && document.body.classList.contains('menu-open')) (document.querySelector('.nav__burger') as HTMLButtonElement)?.click(); });
  const btn = document.querySelector<HTMLButtonElement>('.nav__burger');
  const menu = document.getElementById('menu-mobile');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
    if (menu) {
      if (open) { menu.classList.remove('is-open'); setTimeout(() => (menu.hidden = true), 300); }
      else { menu.hidden = false; requestAnimationFrame(() => menu.classList.add('is-open')); }
    }
    document.body.classList.toggle('menu-open', !open);
  });
</script>

<style>
  .nav-wrap { position: fixed; inset: 20px 0 auto; margin-inline: auto; width: min(1360px, calc(100% - 48px)); z-index: 50; }
  .nav {
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 24px;
    padding: 10px; border-radius: 999px;
    background: rgba(13, 26, 45, .55); border: 1px solid rgba(255, 255, 255, .14);
    -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, .25);
  }
  .nav__logo { justify-self: start; margin-left: 18px; }
  .nav__logo img { height: 22px; width: auto; }
  .nav__right { display: flex; align-items: center; justify-content: flex-end; gap: 16px; }
  .nav__pill {
    display: flex; gap: 4px; padding: 4px; border-radius: 999px;
    background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12);
  }
  .nav__pill a {
    display: block; padding: 9px 16px; border-radius: 999px;
    font-family: var(--font-display); font-weight: 800; font-size: 16px; letter-spacing: .04em; text-transform: uppercase;
    transition: background-color .2s;
  }
  .nav__pill a:hover, .nav__pill a[aria-current='page'] { background: rgba(255, 255, 255, .1); }
  .nav__cta { padding: 13px 22px; }
  .statut {
    display: inline-flex; align-items: center; gap: 9px; white-space: nowrap;
    font-family: var(--font-body); font-weight: 600; font-size: 13px; letter-spacing: .01em; color: var(--bone);
  }
  .statut__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--slate); flex: none; }
  .statut.is-open .statut__dot { background: #3ddc84; box-shadow: 0 0 0 0 rgba(61, 220, 132, .6); animation: statut-pulse 2.2s infinite; }
  @keyframes statut-pulse { 70% { box-shadow: 0 0 0 8px rgba(61, 220, 132, 0); } 100% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0); } }
  .statut--nav { padding: 0; }
  .statut--menu { margin-bottom: 16px; padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); }
  @media (max-width: 1439px) { .statut--nav { display: none !important; } }
  @media (prefers-reduced-motion: reduce) { .statut.is-open .statut__dot { animation: none; } }
  .nav__burger {
    display: none; width: 50px; height: 50px; align-items: center; justify-content: center; cursor: pointer;
    border-radius: 999px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18);
    transition: background-color .25s, border-color .25s;
  }
  .nav__burger:hover { background: rgba(255,255,255,.14); }
  .nav__burger[aria-expanded='true'] { background: var(--red); border-color: var(--red); }
  .burger { position: relative; width: 20px; height: 10px; }
  .burger span {
    position: absolute; left: 0; height: 2px; border-radius: 2px; background: var(--bone);
    transition: transform .45s cubic-bezier(.7, 0, .2, 1), width .3s, top .3s .15s, bottom .3s .15s;
  }
  .burger span:first-child { top: 0; width: 20px; }
  .burger span:last-child { bottom: 0; width: 12px; right: 0; left: auto; }
  .nav__burger:hover .burger span:last-child { width: 20px; }
  .nav__burger[aria-expanded='true'] .burger span { transition: top .25s, bottom .25s, width .25s, transform .45s .15s cubic-bezier(.7, 0, .2, 1); width: 20px; }
  .nav__burger[aria-expanded='true'] .burger span:first-child { top: 4px; transform: rotate(45deg); }
  .nav__burger[aria-expanded='true'] .burger span:last-child { bottom: 4px; transform: rotate(-45deg); }
  .menu-mobile { opacity: 0; transform: translateY(-8px) scale(.98); transform-origin: top right; transition: opacity .3s ease, transform .4s cubic-bezier(.16, 1, .3, 1); }
  .menu-mobile.is-open { opacity: 1; transform: none; }
  .menu-mobile li { opacity: 0; transform: translateY(10px); transition: opacity .4s ease, transform .5s cubic-bezier(.16, 1, .3, 1); }
  .menu-mobile.is-open li { opacity: 1; transform: none; }
  .menu-mobile.is-open li:nth-child(2) { transition-delay: .04s; } .menu-mobile.is-open li:nth-child(3) { transition-delay: .08s; }
  .menu-mobile.is-open li:nth-child(4) { transition-delay: .12s; } .menu-mobile.is-open li:nth-child(5) { transition-delay: .16s; }
  .menu-mobile.is-open li:nth-child(6) { transition-delay: .2s; }
  :global(body.menu-open) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .menu-mobile, .menu-mobile li, .burger span { transition: none !important; } }
  .menu-mobile {
    margin-top: 10px; padding: 24px; border-radius: 28px;
    background: rgba(13, 26, 45, .92); border: 1px solid rgba(255, 255, 255, .14);
    -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px);
  }
  .menu-mobile ul { display: grid; gap: 4px; margin-bottom: 20px; }
  .menu-mobile a:not(.btn) { display: block; padding: 10px 4px; font-family: var(--font-display); font-weight: 900; font-size: 34px; text-transform: uppercase; line-height: 1; }
  @media (max-width: 1100px) {
    .nav__pill a { padding: 9px 11px; font-size: 15px; }
  }
  @media (max-width: 960px) {
    .nav-wrap { inset: 12px 0 auto; width: calc(100% - 24px); }
    .nav { padding: 8px; display: flex; justify-content: space-between; }
    .nav__logo { margin-left: 12px; }
    .nav__pill, .nav__right { display: none; }
    .nav__burger { display: inline-flex; }
  }
  @media (min-width: 961px) { .menu-mobile { display: none; } }
</style>
