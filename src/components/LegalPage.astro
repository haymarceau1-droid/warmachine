---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import { ROUTES } from '../data/site';
interface Props { title: string; current: 'mentions' | 'confidentialite' | 'cookies'; sections: string[] }
const { title, current, sections } = Astro.props;
const nav = [['mentions', 'Mentions légales', ROUTES.mentions], ['confidentialite', 'Confidentialité', ROUTES.confidentialite], ['cookies', 'Cookies', ROUTES.cookies]];
---
<Base title={title} cta={false}>
  <PageHero crumb={`Accueil / ${title}`} l1={`${title}.`} image="/images/pano.jpg" />
  <section class="section section--light">
    <div class="container legal">
      <nav class="legal__nav">
        {nav.map(([k, l, h]) => <a href={h} class="display" aria-current={k === current ? 'page' : undefined}>{l}</a>)}
      </nav>
      <div class="legal__body">
        {sections.map((s) => (
          <section><h2 class="display">{s}</h2><p class="muted">[ Contenu juridique à reprendre du site actuel ]</p></section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .legal { display: grid; grid-template-columns: 260px 1fr; gap: 80px; }
  .legal__nav { display: flex; flex-direction: column; gap: 16px; align-self: start; }
  .legal__nav a { font-size: 26px; }
  .legal__nav a[aria-current='page'] { color: var(--red); }
  .legal__body section { padding-block: 24px; border-bottom: 1px solid var(--line-light); }
  .legal__body h2 { font-size: 46px; margin-bottom: 12px; }
  @media (max-width: 900px) { .legal { grid-template-columns: 1fr; gap: 32px; } .legal__nav { flex-direction: row; flex-wrap: wrap; } }
</style>
