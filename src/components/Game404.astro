---
// Mini-jeu de la page 404 : un athlète qui court et saute par-dessus du matériel de cross-training.
---
<section class="game section">
  <div class="container">
    <div class="game__head">
      <p class="eyebrow">En attendant</p>
      <h2 class="display game__title">Le WOD <span class="outline">de la 404.</span></h2>
      <p class="game__lead">Saute par-dessus le matériel et enchaîne les reps. Une erreur et c’est <strong>no rep</strong>.</p>
    </div>

    <div class="game__card">
      <canvas
        id="wod-game"
        class="game__canvas"
        tabindex="0"
        role="img"
        aria-label="Jeu : un athlète court et saute par-dessus des boîtes, des kettlebells et des disques. Espace, flèche haut ou toucher pour sauter."
      ></canvas>
      <p class="game__hint">
        <span class="kbd">Espace</span> <span class="kbd">↑</span> ou touche l’écran pour sauter
      </p>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('wod-game') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const BONE = '#efebe3', SLATE = '#9aa6b8', RED = '#d81d1d';
    const H = 240, GROUND = 196, AX = 72;
    let W = 900, dpr = 1;

    type Obs = { x: number; w: number; h: number; kind: 'box' | 'box2' | 'plates' | 'kb' };
    let obs: Obs[] = [];
    let state: 'idle' | 'run' | 'over' = 'idle';
    let speed = 6, dist = 0, reps = 0, best = 0;
    let y = 0, vy = 0, onGround = true, phase = 0, nextGap = 400, shake = 0;
    let bgX = 0, last = 0, raf = 0, visible = true;

    try { best = Number(localStorage.getItem('wm-wod-best')) || 0; } catch {}

    function resize() {
      const w = Math.min(900, Math.max(300, Math.floor(canvas!.parentElement!.clientWidth)));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = w;
      canvas!.width = W * dpr; canvas!.height = H * dpr;
      canvas!.style.width = W + 'px'; canvas!.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (state !== 'run') draw();
    }

    function reset() {
      obs = []; speed = 6; dist = 0; reps = 0; y = 0; vy = 0; onGround = true; phase = 0; shake = 0;
      nextGap = 420;
    }

    function start() { reset(); state = 'run'; loop(performance.now(), true); }

    function jump() {
      if (state === 'idle' || state === 'over') { if (state === 'over' && lastOver + 350 > performance.now()) return; start(); return; }
      if (onGround) { vy = 11.6; onGround = false; }
    }
    let lastOver = 0;

    function spawn() {
      const kinds: Obs['kind'][] = ['box', 'box', 'box2', 'plates', 'kb', 'kb'];
      const kind = kinds[Math.floor(Math.random() * kinds.length)];
      const dim = { box: [44, 42], box2: [92, 42], plates: [24, 62], kb: [30, 34] }[kind];
      obs.push({ x: W + 20, w: dim[0], h: dim[1], kind });
      nextGap = speed * 40 + 120 + Math.random() * 220;
    }

    function update(dt: number) {
      speed = Math.min(13.5, speed + 0.0022 * dt);
      dist += speed * dt;
      reps = Math.floor(dist / 55);
      bgX = (bgX + speed * 0.35 * dt) % 400;
      phase += speed * 0.045 * dt;
      if (!onGround) {
        y += vy * dt; vy -= 0.62 * dt;
        if (y <= 0) { y = 0; vy = 0; onGround = true; }
      }
      for (const o of obs) o.x -= speed * dt;
      obs = obs.filter((o) => o.x + o.w > -20);
      nextGap -= speed * dt;
      if (nextGap <= 0) spawn();
      // collisions (hitbox un peu indulgente)
      const ax0 = AX - 9, ax1 = AX + 9, ay1 = GROUND - y, ay0 = ay1 - 60;
      for (const o of obs) {
        const ox0 = o.x + 4, ox1 = o.x + o.w - 4, oy0 = GROUND - o.h + 4;
        if (ax1 > ox0 && ax0 < ox1 && ay1 > oy0 && ay0 < GROUND) { gameOver(); break; }
      }
    }

    function gameOver() {
      state = 'over'; shake = 10; lastOver = performance.now();
      if (reps > best) { best = reps; try { localStorage.setItem('wm-wod-best', String(best)); } catch {} }
    }

    // ---------- dessin ----------
    function limb(x1: number, y1: number, x2: number, y2: number, w: number) {
      ctx.lineWidth = w; ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    }

    function athlete() {
      const hipY = GROUND - 28 - y, shY = hipY - 22, headY = shY - 12;
      ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = BONE; ctx.fillStyle = BONE;
      const air = !onGround && state === 'run';
      const dead = state === 'over';
      const s = Math.sin(phase), c = Math.cos(phase);
      // jambes
      const leg = (ang: number, back: boolean) => {
        const thigh = 15, shin = 15;
        const kx = AX + Math.sin(ang) * thigh, ky = hipY + Math.cos(ang) * thigh;
        const bend = back ? ang - 1.1 : ang + 0.5;
        const fx = kx + Math.sin(bend) * shin, fy = Math.min(GROUND - y, ky + Math.cos(bend) * shin);
        ctx.strokeStyle = back ? SLATE : BONE;
        limb(AX, hipY, kx, ky, 7); limb(kx, ky, fx, fy, 6);
      };
      if (air) { leg(0.9, true); leg(-0.3, false); }
      else if (dead) { leg(0.3, false); leg(-0.3, true); }
      else { leg(s * 0.95, s < 0); leg(-s * 0.95, s >= 0); }
      // bras
      const arm = (ang: number, back: boolean) => {
        const ex = AX + Math.sin(ang) * 12, ey = shY + 4 + Math.cos(ang) * 12;
        const hx = ex + Math.sin(ang - 1.1) * 11, hy = ey + Math.cos(ang - 1.1) * 11 * 0.6;
        ctx.strokeStyle = back ? SLATE : BONE;
        limb(AX, shY + 2, ex, ey, 5); limb(ex, ey, hx, hy, 5);
      };
      if (air) { arm(-2.3, true); arm(-2.7, false); }
      else if (dead) { arm(0.6, false); arm(-0.6, true); }
      else { arm(c * 0.9, c < 0); arm(-c * 0.9, c >= 0); }
      // tronc (légère inclinaison vers l'avant)
      ctx.strokeStyle = BONE; limb(AX, hipY, AX + 3, shY, 11);
      // tête + bandeau
      ctx.beginPath(); ctx.arc(AX + 4, headY, 8, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = RED; limb(AX - 3, headY - 3, AX + 11, headY - 3, 3.5);
    }

    function obstacle(o: Obs) {
      const top = GROUND - o.h;
      ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      if (o.kind === 'box' || o.kind === 'box2') {
        ctx.fillStyle = '#cfc8b8'; ctx.fillRect(o.x, top, o.w, o.h);
        ctx.strokeStyle = '#8c8574'; ctx.lineWidth = 2; ctx.strokeRect(o.x + 1, top + 1, o.w - 2, o.h - 2);
        ctx.beginPath(); ctx.moveTo(o.x + 1, top + o.h * 0.5); ctx.lineTo(o.x + o.w - 1, top + o.h * 0.5); ctx.stroke();
        ctx.fillStyle = '#26395a'; ctx.fillRect(o.x + o.w / 2 - 10, top + 8, 20, 4); // poignée
      } else if (o.kind === 'plates') {
        ctx.fillStyle = SLATE; ctx.fillRect(o.x + o.w / 2 - 2, top - 2, 4, o.h + 2); // barre
        const cols = ['#efebe3', '#9aa6b8', '#efebe3'];
        for (let i = 0; i < 3; i++) {
          ctx.fillStyle = cols[i];
          ctx.beginPath(); ctx.roundRect(o.x, GROUND - 18 * (i + 1) + 1, o.w, 16, 4); ctx.fill();
        }
      } else {
        // kettlebell
        ctx.strokeStyle = SLATE; ctx.lineWidth = 5;
        ctx.beginPath(); ctx.arc(o.x + o.w / 2, top + 9, 9, Math.PI, 0); ctx.stroke();
        ctx.fillStyle = '#efebe3';
        ctx.beginPath(); ctx.arc(o.x + o.w / 2, GROUND - 14, 15, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#26395a'; ctx.font = '800 12px Archivo, sans-serif'; ctx.textAlign = 'center';
        ctx.fillText('16', o.x + o.w / 2, GROUND - 10);
      }
    }

    function background() {
      ctx.fillStyle = '#112238'; ctx.fillRect(0, 0, W, H);
      // rigs en silhouette (parallaxe)
      ctx.fillStyle = 'rgba(255,255,255,.05)';
      for (let i = -1; i < Math.ceil(W / 400) + 1; i++) {
        const x = i * 400 - bgX;
        ctx.fillRect(x + 40, 40, 8, GROUND - 40); ctx.fillRect(x + 190, 40, 8, GROUND - 40);
        ctx.fillRect(x + 30, 40, 178, 8);
        ctx.fillRect(x + 260, 80, 6, GROUND - 80); ctx.fillRect(x + 330, 80, 6, GROUND - 80); ctx.fillRect(x + 255, 80, 86, 6);
      }
      // sol
      ctx.fillStyle = '#0d1a2d'; ctx.fillRect(0, GROUND, W, H - GROUND);
      ctx.fillStyle = BONE; ctx.fillRect(0, GROUND, W, 2);
      ctx.fillStyle = 'rgba(239,235,227,.25)';
      const off = (dist % 60);
      for (let x = -off; x < W; x += 60) ctx.fillRect(x, GROUND + 14, 18, 2);
    }

    function hud() {
      ctx.textAlign = 'right'; ctx.fillStyle = SLATE; ctx.font = '600 12px Archivo, sans-serif';
      ctx.fillText('RECORD  ' + String(best).padStart(3, '0'), W - 18, 28);
      ctx.fillStyle = BONE; ctx.font = '900 30px "Big Shoulders Display", Archivo, sans-serif';
      ctx.fillText(String(reps).padStart(3, '0') + ' REPS', W - 18, 58);
    }

    function banner(title: string, sub: string) {
      ctx.fillStyle = 'rgba(13,26,45,.72)'; ctx.fillRect(0, 0, W, GROUND);
      ctx.textAlign = 'center'; ctx.fillStyle = BONE;
      ctx.font = `900 ${W < 480 ? 44 : 64}px "Big Shoulders Display", Archivo, sans-serif`;
      ctx.fillText(title, W / 2, 92);
      ctx.fillStyle = SLATE; ctx.font = '500 15px Archivo, sans-serif';
      ctx.fillText(sub, W / 2, 124);
    }

    function draw() {
      ctx.save();
      if (shake > 0) ctx.translate((Math.random() - 0.5) * shake, (Math.random() - 0.5) * shake);
      background();
      obs.forEach(obstacle);
      athlete();
      hud();
      if (state === 'idle') banner('PRÊT POUR LE WOD ?', 'Appuie sur espace ou touche pour lancer');
      if (state === 'over') banner('NO REP.', `${reps} reps · espace ou touche pour rejouer`);
      ctx.restore();
    }

    function loop(now: number, fresh = false) {
      cancelAnimationFrame(raf);
      if (fresh) last = now;
      const dt = Math.min(2.2, (now - last) / 16.667); last = now;
      if (state === 'run') update(dt);
      if (shake > 0) shake = Math.max(0, shake - 0.8 * dt);
      draw();
      if ((state === 'run' || shake > 0) && visible && !document.hidden) raf = requestAnimationFrame((t) => loop(t));
    }

    // ---------- entrées ----------
    window.addEventListener('keydown', (e) => {
      if (e.code !== 'Space' && e.code !== 'ArrowUp') return;
      const t = e.target as HTMLElement;
      if (t && t !== canvas && /^(BUTTON|A|INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      if (!visible) return;
      e.preventDefault();
      if (!e.repeat) jump();
    });
    canvas.addEventListener('pointerdown', (e) => { e.preventDefault(); canvas.focus({ preventScroll: true }); jump(); });
    canvas.style.touchAction = 'manipulation';

    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      if (visible && state === 'run') loop(performance.now(), true);
    }, { threshold: 0.2 }).observe(canvas);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && state === 'run') loop(performance.now(), true); });
    window.addEventListener('resize', resize);

    resize();
    (document.fonts?.ready ?? Promise.resolve()).then(() => { if (state !== 'run') draw(); });
  }
</script>

<style>
  .game { background: var(--navy); padding-top: clamp(24px, 4vw, 48px); }
  .game__head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }
  .game__title { font-size: clamp(44px, 6vw, 80px); line-height: .95; }
  .game__lead { color: var(--slate); max-width: 520px; }
  .game__lead strong { color: var(--bone); }
  .game__card {
    padding: clamp(10px, 2vw, 18px); border-radius: 28px;
    background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 255, 255, .12);
    display: flex; flex-direction: column; align-items: center; gap: 14px;
  }
  .game__canvas { display: block; max-width: 100%; border-radius: 18px; cursor: pointer; outline: none; user-select: none; -webkit-user-select: none; }
  .game__canvas:focus-visible { outline: 2px solid var(--bone); outline-offset: 4px; }
  .game__hint { font-size: 13px; color: var(--slate); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .kbd { padding: 3px 9px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, .22); background: rgba(255, 255, 255, .06); color: var(--bone); font-weight: 600; font-size: 12px; }
</style>
