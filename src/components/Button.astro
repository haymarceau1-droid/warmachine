---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'glass' | 'dark';
  icon?: IconName;
  block?: boolean;
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', icon = 'calendrier', block, type = 'button', external, class: cls } = Astro.props;
const classes = ['btn', `btn--${variant}`, block && 'btn--block', cls];
---
{href ? (
  <a href={href} class:list={classes} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
    <Icon name={icon} /><span><slot /></span>
  </a>
) : (
  <button type={type} class:list={classes}>
    <Icon name={icon} /><span><slot /></span>
  </button>
)}
