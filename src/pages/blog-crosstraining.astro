---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { ARTICLES } from '../data/site';
const [une, ...rest] = [ARTICLES[0], ...ARTICLES.slice(1)];
const cats = ['Tous', ...new Set(ARTICLES.map((a) => a.cat))];
---
<Base title="Blog & conseils de coachs" description="Entraînement, mobilité, nutrition : les conseils de l’équipe WM Athletics pour progresser.">
  <PageHero crumb="Accueil / Blog" l1="Blog" l2="& conseils de coachs." image="/images/barre.jpg" intro="Entraînement, mobilité, nutrition : les conseils de l’équipe WM pour progresser dans et en dehors de la salle." />
  <div class="container filters" role="group" aria-label="Filtrer par catégorie">
    {cats.map((c, i) => <button type="button" class="filter" aria-pressed={i === 0 ? 'true' : 'false'} data-cat={c}>{c}</button>)}
  </div>
  <section class="section section--light">
    <div class="container">
      <a class="une" href={`/${une.slug}/`} data-cat={une.cat}>
        <div class="photo une__img" style={`background-image:url('${une.image}')`}></div>
        <div class="stack une__body">
          <p class="eyebrow">À la une · {une.cat}</p>
          <h2 class="display une__title">{une.titre}</h2>
          <p class="muted">{une.extrait}</p>
          {une.auteur && <p class="small" style="font-weight:600">Par {une.auteur}</p>}
          <span class="btn btn--primary" style="align-self:flex-start"><Icon name="lecture" /><span>Lire l'article</span></span>
        </div>
      </a>
      <div class="grid grid-3 posts">
        {rest.map((a) => (
          <a class="post" href={`/${a.slug}/`} data-cat={a.cat}>
            <div class="photo post__img" style={`background-image:url('${a.image}')`}></div>
            <p class="eyebrow">{a.cat}</p>
            <h3 class="display post__title">{a.titre}</h3>
            <p class="small muted">{a.extrait}</p>
            <span class="post__more"><Icon name="lecture" />Lire l'article</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('[data-cat]:not(.filter)');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    items.forEach((it) => (it.hidden = b.dataset.cat !== 'Tous' && it.dataset.cat !== b.dataset.cat));
  }));
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 12px; padding-bottom: 56px; }
  .filter { border: 1px solid var(--line); background: none; color: var(--bone); border-radius: 99px; padding: 10px 20px; cursor: pointer; font-family: var(--font-display); font-weight: 800; font-size: 16px; letter-spacing: .04em; text-transform: uppercase; }
  .filter[aria-pressed='true'] { background: var(--red); border-color: var(--red); }
  .une { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; margin-bottom: 72px; }
  .une[hidden], .post[hidden] { display: none; }
  .une__img { aspect-ratio: 16 / 10; }
  .une__body { gap: 18px; }
  .une__title { font-size: clamp(44px, 4.5vw, 64px); line-height: .95; }
  .posts { gap: 56px 24px; }
  .post { display: flex; flex-direction: column; gap: 12px; }
  .post__img { aspect-ratio: 16 / 10; margin-bottom: 6px; }
  .post__title { font-size: 34px; line-height: 1; }
  .post__more { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  @media (max-width: 900px) { .une { grid-template-columns: 1fr; gap: 28px; } }
</style>
