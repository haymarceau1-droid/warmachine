---
// Page d'un article du blog. Les URL restent à la racine, comme sur le site actuel.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { render } from 'astro:content';
import { getArticles, cover, formatDate, type ArticleEntry } from '../lib/articles';

export async function getStaticPaths() {
  const list = await getArticles();
  return list.map((a) => ({ params: { slug: a.id }, props: { a, list } }));
}
const { a, list } = Astro.props as { a: ArticleEntry; list: ArticleEntry[] };
const { Content } = await render(a);
const d = a.data;
const others = list.filter((x) => x.id !== a.id).slice(0, 3);
---
<Base title={d.titre} description={d.extrait}>
  <header class="ahead">
    <div class="container ahead__inner">
      <p class="crumb">[ <a href="/">Accueil</a> / <a href="/blog-crosstraining/">Blog</a> / {d.categorie} ]</p>
      <h1 class="display ahead__title">{d.titre}</h1>
      <div class="ahead__meta">
        {d.auteur && <><span class="avatar display" aria-hidden="true">{d.auteur[0]}</span><strong>Par {d.auteur}</strong></>}
        <span class="crumb">[ <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> ]</span>
      </div>
    </div>
  </header>
  <div class="photo cover" style={`background-image:url('${cover(a)}')`}></div>

  <article class="section section--light">
    <div class="prose">
      <Content />
      {d.auteur && (
        <div class="author">
          <span class="avatar avatar--lg display" aria-hidden="true">{d.auteur[0]}</span>
          <div><p class="display" style="font-size:30px">{d.auteur}</p>{d.role && <p class="small muted">{d.role}</p>}</div>
        </div>
      )}
    </div>
  </article>

  {others.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow" style="margin-bottom:32px">À lire aussi</p>
        <div class="grid grid-3">
          {others.map((o) => (
            <a class="post" href={`/${o.id}/`}>
              <div class="photo post__img" style={`background-image:url('${cover(o)}')`}></div>
              <h3 class="display post__title">{o.data.titre}</h3>
              <span class="post__more"><Icon name="lecture" />Lire l'article</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .ahead__inner { max-width: 1000px; display: flex; flex-direction: column; gap: 24px; padding-top: clamp(140px, 15vw, 200px); padding-bottom: 64px; }
  .crumb a:hover { color: var(--bone); }
  .ahead__title { font-size: clamp(48px, 7vw, 101px); line-height: .95; }
  .ahead__meta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; font-size: 15px; }
  .avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--navy-600); display: grid; place-items: center; font-size: 22px; color: var(--bone); }
  .avatar--lg { width: 72px; height: 72px; background: var(--navy); font-size: 34px; flex: none; }
  .cover { aspect-ratio: 1440 / 620; max-height: 640px; width: 100%; }

  /* Mise en forme du contenu écrit dans l'admin */
  .prose { max-width: 760px; margin-inline: auto; padding-inline: 20px; display: flex; flex-direction: column; gap: 24px; font-size: 19px; line-height: 1.65; }
  .prose :global(article) { display: flex; flex-direction: column; gap: 24px; }
  .prose :global(article > p:first-child) { font-size: 23px; font-weight: 500; line-height: 1.55; }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(40px, 4vw, 55px); line-height: 1; margin-top: 16px; }
  .prose :global(h3) { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: 32px; line-height: 1.05; margin-top: 8px; }
  .prose :global(a) { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(blockquote) { margin: 0; padding: 8px 0 8px 24px; border-left: 4px solid var(--red); }
  .prose :global(blockquote p) { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(30px, 3vw, 39px); line-height: 1.1; }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding: 0; list-style: none; counter-reset: li; }
  .prose :global(li) { position: relative; padding: 16px 0 16px 56px; border-top: 1px solid var(--line-light); }
  .prose :global(ol > li)::before { counter-increment: li; content: counter(li, decimal-leading-zero); position: absolute; left: 0; top: 12px; font-family: var(--font-display); font-weight: 900; font-size: 30px; color: var(--red); }
  .prose :global(ul > li)::before { content: ''; position: absolute; left: 8px; top: 27px; width: 14px; height: 3px; background: var(--red); }
  .prose :global(img) { width: 100%; height: auto; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line-light); margin: 8px 0; }
  .author { display: flex; align-items: center; gap: 20px; padding: 28px; background: var(--light); margin-top: 16px; }

  .post { display: flex; flex-direction: column; gap: 14px; }
  .post__img { aspect-ratio: 16 / 10; }
  .post__title { font-size: 34px; line-height: 1; }
  .post__more { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
</style>
